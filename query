- interval options
"fixed_interval": "1m"   // strict: 10s, 30s, 1m, 5m, 1h, 1d
"calendar_interval": "1d" // calendar-aware: 1d, 1w, 1M, 1q, 1y
                          // handles DST, month lengths correctly

- nested aggregation options
// count
"value_count": { "field": "_id" }

// numeric stats
"avg":    { "field": "cpu_percent" }
"min":    { "field": "cpu_percent" }
"max":    { "field": "cpu_percent" }
"sum":    { "field": "request_count" }

// percentiles
"percentiles": { 
  "field": "latency_ms", 
  "percents": [50, 95, 99] 
}

// group by field inside each time bucket
"terms": { 
  "field": "host",
  "size": 10          // top 10 hosts
}

// stats all at once
"stats": { "field": "cpu_percent" }
// returns min, max, avg, sum, count in one shot


- avg cpu per host per minute
{
  "size": 0,
  "query": {
    "range": { "@timestamp": { "gte": "now-1h" } }
  },
  "aggs": {
    "over_time": {
      "date_histogram": {
        "field": "@timestamp",
        "fixed_interval": "1m"
      },
      "aggs": {
        "by_host": {
          "terms": { "field": "host", "size": 3 },
          "aggs": {
            "avg_cpu": { "avg": { "field": "cpu_percent" } }
          }
        }
      }
    }
  }
}


