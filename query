- raw query for elasticsearch, to be used in Kibana Dev Tools or in a curl command

GET metrics/_mapping
GET _cat/indices?v
GET _data_stream/metrics-*
{
  "size": 0,
  "query": { "range": { "@timestamp": { "gte": "now-1h" } } },
  "aggs": {
    "over_time": {
      "date_histogram": {
        "field": "@timestamp",
        "fixed_interval": "1m"
      },
      "aggs": {
        "doc_count": { "value_count": { "field": "_id" } }
      }
    }
  }
}


"size": 0    → return 0 raw docs, only aggregation results (what you want for dashboards)
"size": 10   → return 10 raw docs + aggregation results
"size": 100  → return 100 raw docs + aggregation results


- break down of the raw query roll up
{
  "size": 0,                          // no raw docs, aggs only

  "query": {                          // filter BEFORE aggregating
    "range": {
      "@timestamp": {
        "gte": "now-1h",              // last 1 hour
        "lte": "now"                  // optional, now is default
      }
    }
  },

  "aggs": {                           // aggregations
    "over_time": {                    // arbitrary name, you choose this
      "date_histogram": {             // bucket type
        "field": "@timestamp",
        "fixed_interval": "1m",       // bucket size: 1m, 5m, 1h, 1d etc
        "min_doc_count": 0,           // optional: show empty buckets
        "extended_bounds": {          // optional: force full range even if no data
          "min": "now-1h",
          "max": "now"
        }
      },
      "aggs": {                       // nested aggs inside each bucket
        "doc_count": { 
          "value_count": { 
            "field": "_id"            // count docs
          }
        }
      }
    }
  }
}

- time range options
"range": {
  "@timestamp": {
    "gte": "now-1h",      // relative: now-1h, now-7d, now-30m
    "gte": "2026-05-09T00:00:00Z",  // absolute ISO
    "gte": "now/d",       // rounded: start of today
    "lte": "now",
    "lte": "now/d"        // end of today
  }
}


